-47ed-a312-8fe9f5a760e0\",","        \"colab\": {","          \"base_uri\": \"https://localhost:8080/\",","          \"height\": 489","        }","      },","      \"execution_count\": 23,","      \"outputs\": [","        {","          \"output_type\": \"display_data\",","          \"data\": {","            \"text/plain\": [","              \"\u003cFigure size 640x480 with 1 Axes\u003e\"","            ],","            \"image/png\": \"\\n\"","          },","          \"metadata\": {}","        },","        {","          \"output_type\": \"stream\",","          \"name\": \"stdout\",","          \"text\": [","            \"Efter iteration 4: w = 2.86, b = 4.05, Förlust = 0.8247\\n\"","          ]","        }","      ]","    },","    {","      \"cell_type\": \"markdown\",","      \"source\": [","        \"##Iteration 5:\\n\",","        \"Modellen fortsätter att förbättras med nya vikter\"","      ],","      \"metadata\": {","        \"id\": \"pNB03aGDe819\"","      }","    },","    {","      \"cell_type\": \"code\",","      \"source\": [","        \"# Iteration 5\\n\",","        \"y_pred = w * X + b\\n\",","        \"loss = (1 / len(X)) * np.sum((y_pred - y) ** 2)\\n\",","        \"\\n\",","        \"dw = (2 / len(X)) * np.sum(X * (y_pred - y))\\n\",","        \"db = (2 / len(X)) * np.sum(y_pred - y)\\n\",","        \"\\n\",","        \"w -= learning_rate * dw\\n\",","        \"b -= learning_rate * db\\n\",","        \"\\n\",","        \"plt.scatter(X, y, label=\\\"Datapunkter\\\")\\n\",","        \"plt.plot(X, w * X + b, color=\\\"red\\\", label=\\\"Modell efter iteration 5\\\")\\n\",","        \"plt.xlabel(\\\"X\\\")\\n\",","        \"plt.ylabel(\\\"y\\\")\\n\",","        \"plt.legend()\\n\",","        \"plt.title(\\\"Gradientnedstigning: Iteration 5\\\")\\n\",","        \"plt.show()\\n\",","        \"\\n\",","        \"print(f\\\"Efter iteration 5: w = {w[0]:.2f}, b = {b[0]:.2f}, Förlust = {loss:.4f}\\\")\\n\"","      ],","      \"metadata\": {","        \"id\": \"thtNJ9gme8ht\",","        \"outputId\": \"745ce80e-e526-4285-b107-5c75c54f978e\",","        \"colab\": {","          \"base_uri\": \"https://localhost:8080/\",","          \"height\": 489","        }","      },","      \"execution_count\": 24,","      \"outputs\": [","        {","          \"output_type\": \"display_data\",","          \"data\": {","            \"text/plain\": [","              \"\u003cFigure size 640x480 with 1 Axes\u003e\"","            ],","            \"image/png\": \"\\n\"","          },","          \"metadata\": {}","        },","        {","          \"output_type\": \"stream\",","          \"name\": \"stdout\",","          \"text\": [","            \"Efter iteration 5: w = 2.87, b = 4.06, Förlust = 0.8166\\n\"","          ]","        }","      ]","    },","    {","      \"cell_type\": \"markdown\",","      \"source\": [","        \"## Fortsätt träningen\\n\",","        \"Här kan du fortsätta träningen genom att välja hur många ytterligare iterationer som ska köras.\\n\",","        \"Observera att iterationerna börjar från den aktuella nivån (t.ex. 6 om vi redan kört 5 iterationer).\\n\",","        \"Du kan ange ett antal iterationer i rutan och se hur modellen fortsätter förbättras.\\n\"","      ],","      \"metadata\": {","        \"id\": \"hrW5s98JkJfh\"","      }","    },","    {","      \"cell_type\": \"code\",","      \"source\": [","        \"# Låt användaren välja antal iterationer\\n\",","        \"valda_iterationer = int(input(\\\"Ange antal iterationer du vill köra (t.ex. 10): \\\"))\\n\",","        \"\\n\",","        \"# Hämta nuvarande iteration som startpunkt\\n\",","        \"start_iteration = 6  # Om vi redan har kört 5 iterationer\\n\",","        \"\\n\",","        \"# Kör gradientnedstigning för valda iterationer\\n\",","        \"for iteration in range(valda_iterationer):\\n\",","        \"    y_pred = w * X + b  # Förutsägelse\\n\",","        \"    loss = (1 / len(X)) * np.sum((y_pred - y) ** 2)  # Förlust (MSE)\\n\",","        \"\\n\",","        \"    # Beräkna gradienter\\n\",","        \"    dw = (2 / len(X)) * np.sum(X * (y_pred - y))\\n\",","        \"    db = (2 / len(X)) * np.sum(y_pred - y)\\n\",","        \"\\n\",","        \"    # Uppdatera parametrar\\n\",","        \"    w -= learning_rate * dw\\n\",","        \"    b -= learning_rate * db\\n\",","        \"\\n\",","        \"    # Beräkna den korrekta iterationen\\n\",","        \"    current_iteration = start_iteration + iteration\\n\",","        \"\\n\",","        \"    # Skriv ut resultat varje 5:e iteration (eller den sista iterationen)\\n\",","        \"    if iteration % 1 == 0 or iteration == valda_iterationer - 1:\\n\",","        \"        print(f\\\"Iteration {current_iteration}: w = {w[0]:.2f}, b = {b[0]:.2f}, Förlust = {loss:.4f}\\\")\\n\",","        \"\\n\",","        \"# Plotta slutresultatet\\n\",","        \"plt.scatter(X, y, label=\\\"Datapunkter\\\")\\n\",","        \"plt.plot(X, w * X + b, color=\\\"red\\\", label=f\\\"Modell efter {start_iteration + valda_iterationer - 1} iterationer\\\")\\n\",","        \"plt.xlabel(\\\"X\\\")\\n\",","        \"plt.ylabel(\\\"y\\\")\\n\",","        \"plt.legend()\\n\",","        \"plt.title(f\\\"Gradientnedstigning: {start_iteration + valda_iterationer - 1} iterationer\\\")\\n\",","        \"plt.show()\\n\"","      ],","      \"metadata\": {","        \"id\": \"X_W6ShdrkJtU\",","        \"outputId\": \"8d0c88a1-b369-4453-cd8b-2ddbc7a074fc\",","        \"colab\": {","          \"base_uri\": \"https://localhost:8080/\",","          \"height\": 836","        }","      },","      \"execution_count\": 25,","      \"outputs\": [","        {","          \"output_type\": \"stream\",","          \"name\": \"stdout\",","          \"text\": [","            \"Ange antal iterationer du vill köra (t.ex. 10): 20\\n\",","            \"Iteration 6: w = 2.87, b = 4.07, Förlust = 0.8135\\n\",","            \"Iteration 7: w = 2.88, b = 4.08, Förlust = 0.8123\\n\",","            \"Iteration 8: w = 2.87, b = 4.09, Förlust = 0.8116\\n\",","            \"Iteration 9: w = 2.87, b = 4.09, Förlust = 0.8112\\n\",","            \"Iteration 10: w = 2.87, b = 4.10, Förlust = 0.8108\\n\",","            \"Iteration 11: w = 2.87, b = 4.10, Förlust = 0.8105\\n\",","            \"Iteration 12: w = 2.86, b = 4.11, Förlust = 0.8103\\n\",","            \"Iteration 13: w = 2.86, b = 4.11, Förlust = 0.8100\\n\",","            \"Iteration 14: w = 2.86, b = 4.12, Förlust = 0.8098\\n\",","            \"Iteration 15: w = 2.85, b = 4.12, Förlust = 0.8096\\n\",","            \"Iteration 16: w = 2.85, b = 4.12, Förlust = 0.8094\\n\",","            \"Iteration 17: w = 2.85, b = 4.13, Förlust = 0.8092\\n\",","            \"Iteration 18: w = 2.85, b = 4.13, Förlust = 0.8090\\n\",","            \"Iteration 19: w = 2.84, b = 4.13, Förlust = 0.8089\\n\",","            \"Iteration 20: w = 2.84, b = 4.13, Förlust = 0.8087\\n\",","            \"Iteration 21: w = 2.84, b = 4.14, Förlust = 0.8086\\n\",","            \"Iteration 22: w = 2.84, b = 4.14, Förlust = 0.8084\\n\",","            \"Iteration 23: w = 2.83, b = 4.14, Förlust = 0.8083\\n\",","            \"Iteration 24: w = 2.83, b = 4.14, Förlust = 0.8082\\n\",","            \"Iteration 25: w = 2.83, b = 4.15, Förlust = 0.8081\\n\"","          ]","        },","        {","          \"output_type\": \"display_data\",","          \"data\": {","            \"text/plain\": [","              \"\u003cFigure size 640x480 with 1 Axes\u003e\"","            ],","            \"image/png\": \"\\n\"","          },","          \"metadata\": {}","        }","      ]","    },","    {","      \"cell_type\": \"markdown\",","      \"source\": [","        \"## Sammanfattning och reflektion\\n\",","        \"Det här exemplet visar hur gradientnedstigning fungerar i en väldigt enkel modell med bara en vikt \\\\( w \\\\) och en bias \\\\( b \\\\). Eftersom modellen är så enkel och datasetet litet, krävs bara några få iterationer för att få en hyfsad anpassning.\\n\",","        \"\\n\",","        \"I verkligheten är gradientnedstigning ofta mycket mer komplex. Moderna maskininlärningsmodeller kan ha tusentals eller till och med miljoner vikter som uppdateras samtidigt vid varje iteration. Dessutom krävs ofta hundratals eller tusentals iterationer för att uppnå en bra lösning, särskilt när datasetet är stort eller när modellen ska hantera komplicerade mönster.\\n\",","        \"\\n\",","        \"Även om vårt exempel är förenklat, visar det grundprincipen som används i nästan all maskininlärning: modellen anpassar sig steg för steg genom att minimera förlusten tills den hittar en lösning som fungerar väl för uppgiften.\\n\"","      ],","      \"metadata\": {","        \"id\": \"qZzmT-fgiek4\"","      }","    }","  ]","}"],"stylingDirectives":null,"colorizedLines":null,"csv":null,"csvError":null,"dependabotInfo":{"showConfigurationBanner":false,"configFilePath":null,"networkDependabotPath":"/TheMadMathematician/TheMadMathematician/network/updates","dismissConfigurationNoticePath":"/settings/dismiss-notice/dependabot_configuration_notice","configurationNoticeDismissed":false},"displayName":"Linjär_regression_med_gradient_descent.ipynb","displayUrl":"https://notebooks.githubusercontent.com/view/ipynb?browser=chrome\u0026bypass_fastly=true\u0026color_mode=auto\u0026commit=32e317a471afefab6ca8467619d38ce3cb4a8ca3\u0026device=unknown_device\u0026docs_host=https%3A%2F%2Fdocs.github.com\u0026enc_\u0026logged_in=true\u0026nwo=TheMadMathematician%2FTheMadMathematician\u0026path=Linj%C3%A4r_regression_med_gradient_descent.ipynb\u0026platform=windows\u0026repository_id=835859559\u0026repository_type=Repository\u0026version=131","headerInfo":{"blobSize":"258 KB","deleteTooltip":"Delete this file","editTooltip":"Edit this file","ghDesktopPath":"https://desktop.github.com","isGitLfs":false,"onBranch":true,"shortPath":"847458f","siteNavLoginPath":"/login?return_to=https%3A%2F%2Fgithub.com%2FTheMadMathematician%2FTheMadMathematician%